---
import { render } from 'astro:content';
import Base from './Base.astro';
import StatusBanner from '../components/StatusBanner.astro';
import Toc from '../components/Toc.astro';
import { entryUrl, formatDate, localeHome, peersOf, readingMinutes, type Entry, type Post } from '../lib/content';
import { t, termLabel } from '../lib/ui';

interface Props {
  entry: Entry;
  prev?: Post;
  next?: Post;
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const a = entry.data.uniblog;
const locale = a.locale;
const peers = await peersOf(entry);
const source = peers.find((p) => p.locale === a.sourceLocale);
const isFallback = a.status === 'fallback';
const isPost = a.collection === 'posts';
const home = localeHome(locale);
const alternates = peers.filter((p) => p.status !== 'fallback');
---
<Base
  locale={locale}
  title={entry.data.title}
  description={entry.data.description ?? entry.data.summary}
  alternates={alternates}
  canonical={isFallback && source ? source.url : entryUrl(entry)}
  noindex={isFallback || entry.data.draft}
  type="article"
>
  <div class="layout">
    <article class="article" data-pagefind-body={isFallback ? undefined : ''} data-key={a.key} data-locale={locale}>
      <header>
        {isPost && (
          <nav class="crumbs ui" aria-label="breadcrumb">
            <a href={home}>{t(locale, 'nav.posts')}</a>
            {entry.data.categories[0] && (
              <>
                <span aria-hidden="true">/</span>
                <a href={`${home}categories/${entry.data.categories[0]}/`}>{termLabel(locale, 'categories', entry.data.categories[0])}</a>
              </>
            )}
          </nav>
        )}
        <h1 lang={isFallback ? a.sourceLocale : undefined}>{entry.data.title}</h1>
        {isPost && (
          <p class="meta ui muted">
            <time datetime={entry.data.date.toISOString()}>{t(locale, 'post.published')} {formatDate(entry.data.date, locale)}</time>
            {entry.data.lastmod && <time datetime={entry.data.lastmod.toISOString()}>· {t(locale, 'post.updated')} {formatDate(entry.data.lastmod, locale)}</time>}
            <span>· {t(locale, 'post.minutes', { n: readingMinutes(entry.body) })}</span>
          </p>
        )}
      </header>
      <StatusBanner entry={entry} peers={peers} />
      <slot name="tools" />
      <div class="prose" lang={isFallback ? a.sourceLocale : undefined}>
        <Content />
      </div>
      {isPost && entry.data.tags.length > 0 && (
        <p class="tags ui">
          {entry.data.tags.map((tag) => <a href={`${home}tags/${tag}/`}>#{termLabel(locale, 'tags', tag)}</a>)}
        </p>
      )}
      {(prev || next) && (
        <nav class="pager ui">
          {next ? <a class="newer" href={entryUrl(next)}><small>{t(locale, 'post.prev')}</small>{next.data.title}</a> : <span />}
          {prev ? <a class="older" href={entryUrl(prev)}><small>{t(locale, 'post.next')}</small>{prev.data.title}</a> : <span />}
        </nav>
      )}
    </article>
    <aside class="rail">
      <div class="sticky"><Toc headings={headings} locale={locale} /></div>
    </aside>
  </div>
</Base>

<style>
  .layout {
    max-width: 76rem; margin: 0 auto; padding: 2.5rem 1.25rem 0;
    display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: 3.5rem;
  }
  .article { min-width: 0; max-width: var(--measure); }
  .crumbs { font-size: 0.85rem; display: flex; gap: 0.5rem; color: var(--fg-muted); }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  h1 { font-family: var(--font-heading); font-size: clamp(1.8rem, 4vw, 2.4rem); line-height: 1.2; margin: 0.4rem 0 0.6rem; letter-spacing: -0.01em; }
  .meta { font-size: 0.88rem; display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0 0 1.75rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2.5rem; font-size: 0.88rem; }
  .tags a { text-decoration: none; padding: 0.1rem 0.6rem; border: 1px solid var(--border); border-radius: 999px; color: var(--fg-muted); }
  .tags a:hover { color: var(--accent); border-color: var(--accent); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2.5rem; }
  .pager a { display: block; padding: 0.8rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); color: var(--fg); text-decoration: none; }
  .pager a:hover { border-color: var(--accent); }
  .pager small { display: block; color: var(--fg-muted); font-size: 0.78rem; }
  .pager .older { text-align: right; }
  .rail .sticky { position: sticky; top: calc(var(--header-h) + 2rem); max-height: calc(100vh - var(--header-h) - 4rem); overflow-y: auto; }
  @media (max-width: 1000px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .rail { display: none; }
  }
</style>
