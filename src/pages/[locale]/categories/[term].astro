---
import Taxonomy from '../../../components/Taxonomy.astro';
import { cfg, LOCALES, postsIn, type Post } from '../../../lib/content';
import { localePath } from '../../../lib/locales';

export async function getStaticPaths() {
  const paths: { params: { locale: string; term: string }; props: { locale: string; posts: Post[] } }[] = [];
  for (const locale of LOCALES) {
    const posts = await postsIn(locale);
    const terms = new Set(posts.flatMap((p) => p.data.categories));
    for (const term of terms) paths.push({ params: { locale: localePath(cfg, locale), term }, props: { locale, posts } });
  }
  return paths;
}
const { locale, posts } = Astro.props;
---
<Taxonomy locale={locale} kind="categories" posts={posts} term={Astro.params.term} />
