# Copy to .env (gitignored) for local use. Only the providers you actually use need keys.
# For GitHub Actions, add the same names under Settings → Secrets and variables → Actions.

# Default engine in site.yaml: DeepSeek via the OpenAI-compatible provider
# (endpoint is set in site.yaml `translate.default.options.baseURL`).
OPENAI_API_KEY=
# OPENAI_BASE_URL=              # only if you don't set options.baseURL in site.yaml

# Other engines (switch with `translate.default` in site.yaml, or `pnpm i18n -p <id>`):
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=            # or `ant auth login`
# DEEPL_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=

# Deploying from your machine with `pnpm ship` (or run `pnpm exec wrangler login` instead):
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
